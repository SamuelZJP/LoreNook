{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mock-backend",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "frontend/dev/mock_backend.py",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LORENOOK_BACKEND=http://127.0.0.1:8765",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend-mock-preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd frontend && npx vite build && LORENOOK_BACKEND=http://127.0.0.1:8765 npx vite preview --port 4173 --strictPort"
      ],
      "port": 4173
    }
  ]
}